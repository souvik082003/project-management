# PMS Environment Configuration Example
DJANGO_ENV=dev
SECRET_KEY=change-this-insecure-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Default in development is SQLite (db.sqlite3)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# For MySQL Production:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=pms_prod
# DB_USER=pms_user
# DB_PASSWORD=your_secure_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=pms-noreply@example.edu

# File Upload Limits
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,zip,ppt,pptx,txt,png,jpg
